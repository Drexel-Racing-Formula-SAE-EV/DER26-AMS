+        h->State=HAL_SPI_STATE_READY;
+    }
+    h->Instance->CR1 &= ~SPI_CR1_SPE;
+    h->Instance->CR1=saved->cr1 & ~SPI_CR1_SPE;
+    h->Init.BaudRatePrescaler=saved->prescaler;
+    if(saved->cr1 & SPI_CR1_SPE) h->Instance->CR1 |= SPI_CR1_SPE;
+    return result;
+}
